{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stodassistenten.example/schemas/capability-resolution-0.1.0.json",
  "title": "Stödassistenten resolved capability payload",
  "description": "Minimal public response shape for resolved feature visibility. It intentionally excludes pricing, entitlements, authorization rules, user identifiers, endpoints and private implementation details.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capabilities"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "enabled"],
        "properties": {
          "capability_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,79}$"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
